{
	"name": "helltop",
	"compatibility_date": "2026-03-12",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "35060e7735dd4c09ac7e7ff9f206be35"
		},
		{
			"binding": "RATE_LIMIT",
			"id": "11dad14f86f04340be5d42265ac6864c"
		}
	],
	"routes": [
		{ "pattern": "helltop.net", "custom_domain": true }
	],
	"vars": {
		"ENVIRONMENT": "production",
		"AUTHELIA_ISSUER_URL": "https://auth.helltop.net",
		"AUTHELIA_CLIENT_ID": "helltop"
	},
	"observability": {
		"enabled": true
	}
}
