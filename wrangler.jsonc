{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "helltop",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-27",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*", "/music/", "/music/index.html"]
	},
	"kv_namespaces": [
		{
			"binding": "MUSIC_STATE",
			"id": "3cc871b9722d443dadc7c04ce79d96d7"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"vars": {
		"JELLYFIN_URL": "https://jellyfin.helltop.net",
		"JELLYFIN_USER": "lucy"
	},
	"routes": [
		{
			"pattern": "helltop.net",
			"custom_domain": true
		}
	]
}
